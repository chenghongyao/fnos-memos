[
  {
    "stepTitle": "访问方式",
    "items": [
      {
        "type": "tips",
        "helpText": "飞牛桌面入口固定走统一网关 <code>/app/Memos</code>。"
      },
      {
        "type": "radio",
        "field": "enable_port",
        "label": "是否额外开放 TCP 端口",
        "initValue": "false",
        "options": [
          {
            "label": "否（仅统一网关，推荐）",
            "value": "false"
          },
          {
            "label": "是（同时支持 http://<NAS>:<端口> 直接访问）",
            "value": "true"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择是否开放 TCP 端口"
          }
        ]
      },
      {
        "type": "text",
        "field": "port",
        "label": "TCP 端口号",
        "initValue": "8081",
        "rules": [
          {
            "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "请输入 1-65535 之间的端口号"
          }
        ]
      },
      {
        "type": "text",
        "field": "host",
        "label": "TCP 监听地址",
        "initValue": "0.0.0.0",
        "rules": []
      },
      {
        "type": "tips",
        "helpText": "保存后自动重启生效。开放端口可被局域网直接访问，请注意风险。"
      }
    ]
  },
  {
    "stepTitle": "统一网关免密登录",
    "items": [
      {
        "type": "radio",
        "field": "sso_mode",
        "label": "使用飞牛用户名登录",
        "initValue": "true",
        "options": [
          {
            "label": "是（推荐）：用飞牛账号自动登录，免密码",
            "value": "true"
          },
          {
            "label": "否：用 Memos 密码登录",
            "value": "false"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择"
          }
        ]
      },
      {
        "type": "radio",
        "field": "sso_admin",
        "label": "飞牛管理员权限",
        "initValue": "true",
        "options": [
          {
            "label": "Memos 管理员",
            "value": "true"
          },
          {
            "label": "普通用户",
            "value": "false"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "开启后，从统一网关打开 Memos 时自动用飞牛账号登录，免去密码；用户名相同则复用已有 Memos 账号。"
      }
    ]
  }
]
