[
  {
    "stepTitle": "访问方式",
    "items": [
      {
        "type": "tips",
        "helpText": "飞牛桌面入口固定使用系统统一网关 <code>/app/Memos</code> 与 app.sock，不会因为下面的端口设置而改变。"
      },
      {
        "type": "radio",
        "field": "enable_port",
        "label": "是否额外开放 TCP 端口",
        "initValue": "false",
        "options": [
          {
            "label": "否（仅统一网关，推荐）",
            "value": "false"
          },
          {
            "label": "是（同时支持 http://<NAS>:<端口> 直接访问）",
            "value": "true"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择是否开放 TCP 端口"
          }
        ]
      },
      {
        "type": "text",
        "field": "port",
        "label": "TCP 端口号",
        "initValue": "8081",
        "rules": [
          {
            "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "请输入 1-65535 之间的端口号"
          }
        ]
      },
      {
        "type": "text",
        "field": "host",
        "label": "TCP 监听地址",
        "initValue": "0.0.0.0",
        "rules": []
      },
      {
        "type": "tips",
        "helpText": "保存后飞牛会自动重启应用使设置生效。开放端口后，局域网内任何人都可以绕过 NAS 登录态直接访问 Memos（仍需 Memos 自己的账号），建议配合防火墙限制来源。"
      }
    ]
  }
]
