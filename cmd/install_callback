# install_callback：安装完成后确保可执行权限与数据目录
APPDEST="${TRIM_APPDEST:-/var/apps/Memos}"
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/Memos}"

mkdir -p "${VAR_DIR}/data"
chmod 755 "${APPDEST}/server/memos" 2>/dev/null || true
chmod 755 "${APPDEST}/server/bridge.js" 2>/dev/null || true

# 保存安装向导里填写的实例外部地址（可选）
if [ -n "${instance_url:-}" ] && [ ! -s "${VAR_DIR}/instance_url" ]; then
    printf '%s\n' "${instance_url}" > "${VAR_DIR}/instance_url" 2>/dev/null || true
fi

exit 0
